# ====================================================================
# SCOFEN MUSIC DISCOVERY & SOVEREIGN A&R PLATFORM
# Environment Variables Configuration
# ====================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# --------------------------------------------------------------------
# STRIPE PAYMENT INTEGRATION
# Obtain keys from https://dashboard.stripe.com/apikeys
# --------------------------------------------------------------------
# Secret API Key (begins with sk_test_ or sk_live_)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"

# Publishable API Key (begins with pk_test_ or pk_live_)
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"

# Optional: Stripe Webhook Signing Secret from Stripe Dashboard > Webhooks
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"

# --------------------------------------------------------------------
# RESEND TRANSACTIONAL EMAIL INTEGRATION
# Obtain key from https://resend.com/api-keys
# --------------------------------------------------------------------
# Resend API Key (begins with re_)
RESEND_API_KEY="re_your_resend_api_key_here"

# Default sender identity. For unverified domains in development, use onboarding@resend.dev
RESEND_FROM_EMAIL="SCOFEN <onboarding@resend.dev>"
